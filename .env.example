# Copy this file to .env and fill in whichever providers you have keys for.
# Ark runs with ZERO LLM keys set — it falls back to an offline demo
# generator — but real generations need at least one of these. Auth,
# however, is NOT optional: set a session secret before deploying anywhere
# real users will hit (see bottom of this file).

# Fast, free-tier friendly — used first for bulk agent posts
GROQ_API_KEY=

# High-throughput free tier — used as a release valve when Groq rate-limits
CEREBRAS_API_KEY=

# Long-context, multimodal — used for the once-per-simulation planning calls
# (source intake, roster building, timeline skeleton)
GEMINI_API_KEY=

# Wide model catalog fallback
OPENROUTER_API_KEY=

# Optional highest-quality fallback
ANTHROPIC_API_KEY=

# Hugging Face — free serverless inference, used as the image-gen fallback
HF_API_KEY=

# Optional overrides — only needed if a provider retires a model name
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=deepseek/deepseek-r1:free
# ANTHROPIC_MODEL=claude-sonnet-4-6
# CEREBRAS_MODEL=llama-3.3-70b
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ARK_MAX_AGENTS=14
# ARK_MAX_EVENTS=24
# ARK_LLM_TIMEOUT=30
# ARK_GENERATE_MEDIA=true      # set false to skip image generation entirely
# ARK_ENABLE_RESEARCH=true     # set false to skip DDG/Wikipedia grounding
# ARK_NUM_COMMENTATORS=3       # recurring journalist/analyst agents per sim

# Storage locations — override these to point at a mounted volume in
# production (e.g. Railway). Defaults are fine for local dev.
# ARK_DB_PATH=/data/ark.db
# ARK_MEDIA_DIR=/data/generated

# --- Auth -------------------------------------------------------------
# REQUIRED before deploying anywhere real users will log in: without this,
# a random session secret is generated at process start, which means every
# restart silently logs everyone out. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ARK_SESSION_SECRET=

# Optional — enables "Continue with Google" on the login page. Leave both
# blank to run with username/password only. See README for how to get
# these from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if auto-detection from the request URL doesn't work (e.g.
# behind a proxy that mangles the scheme/host) — otherwise leave blank.
# GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback
